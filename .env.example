# Choose cerebras for an OpenAI-compatible cloud API, or lm_studio for local text.
MODEL_PROVIDER=cerebras
# API root, including its version path; do not append /chat/completions.
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# Use the key and model IDs issued by the provider at CEREBRAS_BASE_URL.
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=qwen-3.8-27b
CEREBRAS_VISION_MODEL=qwen-3.8-27b
# Change to max_tokens if your provider requires the legacy token-limit field.
CEREBRAS_COMPLETION_TOKEN_FIELD=max_completion_tokens
# OpenAI embeds extracted source chunks and semantic queries, independent of MODEL_PROVIDER.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Retrieval over source text; changing chunk settings triggers startup reindexing.
RETRIEVAL_CHUNK_CHARS=1200
RETRIEVAL_CHUNK_OVERLAP_CHARS=160
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_MIN_SIMILARITY=0.65
# Optional model-generated topic names/prerequisites; deterministic tags are default.
KNOWLEDGE_INFER_TOPICS=false
# Empty overrides use CEREBRAS_TEXT_MODEL or LM_STUDIO_MODEL_ID.
VERIFIER_MODEL=
GRADER_MODEL=
GENERATION_TIMEOUT_SECONDS=480
GENERATION_CHUNK_CHARS=14000
GENERATION_CHUNK_OVERLAP_SEGMENTS=1
# Shared single-process scheduling and per-provider request coordination.
JOB_CONCURRENCY=2
COURSE_JOB_CONCURRENCY=1
PROVIDER_CONCURRENCY=1
PROVIDER_REQUEST_INTERVAL_SECONDS=0
# USD per million tokens, keyed by provider/model. Set your actual rates.
# MODEL_TOKEN_RATES={"openai/text-embedding-3-small":{"input":0.0}}
MODEL_TOKEN_RATES={}

# macOS app install: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_PATH=soffice
MAX_DOCUMENT_PAGES=500

POCKETTA_DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_CLI_PATH=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./vendor/whisper.cpp/models/ggml-base.en.bin
WHISPER_USE_GPU=true
TRANSCRIPTION_BACKEND=faster_whisper
FASTER_WHISPER_MODEL_PATH=D:/Projects/ambient_ai/Hin2Hinglish-ct2
FASTER_WHISPER_MODEL_NAME=turbo
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_BATCH_SIZE=8
FASTER_WHISPER_VAD_FILTER=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL_ID=qwen3.5-4b
LM_STUDIO_API_KEY=
# Legacy LM_STUDIO_TIMEOUT_SECONDS / CHUNK_CHARS / CHUNK_OVERLAP_SEGMENTS
# remain accepted when their GENERATION_* equivalents are absent.
MAX_UPLOAD_MB=200
UNCERTAIN_CONFIDENCE_THRESHOLD=0.60
TEMPORARY_FILE_MAX_AGE_HOURS=24
