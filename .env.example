# Choose cerebras for cloud text + document vision, or lm_studio for local text.
MODEL_PROVIDER=cerebras
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=qwen-3.8-27b
CEREBRAS_VISION_MODEL=qwen-3.8-27b
# macOS app install: /Applications/LibreOffice.app/Contents/MacOS/soffice
# Windows: C:/Program Files/LibreOffice/program/soffice.exe
LIBREOFFICE_PATH=soffice
MAX_DOCUMENT_PAGES=500

POCKETTA_DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
WHISPER_CLI_PATH=./vendor/whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL_PATH=./vendor/whisper.cpp/models/ggml-base.en.bin
WHISPER_USE_GPU=true
TRANSCRIPTION_BACKEND=faster_whisper
FASTER_WHISPER_MODEL_PATH=D:/Projects/ambient_ai/Hin2Hinglish-ct2
FASTER_WHISPER_MODEL_NAME=turbo
FASTER_WHISPER_COMPUTE_TYPE=int8
FASTER_WHISPER_BEAM_SIZE=5
FASTER_WHISPER_BATCH_SIZE=8
FASTER_WHISPER_VAD_FILTER=true
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL_ID=qwen3.5-4b
LM_STUDIO_API_KEY=
LM_STUDIO_TIMEOUT_SECONDS=480
LM_STUDIO_CHUNK_CHARS=14000
LM_STUDIO_CHUNK_OVERLAP_SEGMENTS=1
MAX_UPLOAD_MB=200
UNCERTAIN_CONFIDENCE_THRESHOLD=0.60
TEMPORARY_FILE_MAX_AGE_HOURS=24
